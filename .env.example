# ───────── Core (required) ─────────
# PostgreSQL connection string (local Docker, Supabase Postgres, Neon, RDS …)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Public base URL of the web app (used for links in emails and metadata)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random characters. Encrypts integration credentials (AES-256-GCM) and salts hashed IPs.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Secret for POST /api/internal/run (external scheduler trigger). Generate: openssl rand -hex 32
CRON_SECRET=

# ───────── Background worker ─────────
# true = run the reminder worker inside the web process (single instance / demos).
# Production: leave false and run `npm run worker` as its own service.
EMBEDDED_WORKER=false
WORKER_INTERVAL_MS=60000

# ───────── Auth / platform email (optional) ─────────
# When BOTH are set, signup requires email verification and password reset emails are sent.
# When unset, accounts are auto-verified (development convenience).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Development only: show verification / reset links on screen when no mailer is configured.
AUTH_DEV_LINKS=false
# Comma-separated emails that become platform admins at signup (the very first account also becomes admin).
ADMIN_EMAILS=

# ───────── Delivery webhooks (optional) ─────────
# Svix signing secret from the Resend webhook settings (whsec_…)
RESEND_WEBHOOK_SECRET=

# ───────── WhatsApp Business Platform (optional, disabled until all set) ─────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Name of your *approved* message template (body variables: client, invoice no., balance, due date)
WHATSAPP_TEMPLATE_NAME=
